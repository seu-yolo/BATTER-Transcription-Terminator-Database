{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bted-catalogue-v03-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "../../site",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "BTED_DB",
      "database_name": "bted-catalogue-v03-preview",
      "database_id": "replace-after-d1-create"
    }
  ],
  "vars": {
    "HF_RESOLVE_BASE": "https://huggingface.co/datasets/seu-yolo/BTED-v0.3-assets/resolve/d12190e434057edaf2c2bdbf19132f1e41873c38",
    "ALLOWED_ORIGIN_HOST": "huggingface.co"
  }
}
